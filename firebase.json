{
  "functions": [
    {
      "source": "functions",
      "codebase": "lomeal",
      "ignore": ["node_modules", ".git", "*.log"],
      "predeploy": ["node ../copy-env.cjs"]
    }
  ],
  "hosting": {
    "target": "lomeal",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/ota/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}